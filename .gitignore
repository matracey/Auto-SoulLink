__pycache__/
*.pyc
*.pyo
.pytest_cache/
data/links.json
data/memorial.json
data/events.json
data/runs/
data/backups/
data/*.log
data/*.log.*
*.State
*.sav
# ROM files — never commit these (copyright, repo size). Covers the common
# extensions for the platforms SLink supports.
*.gb
*.gbc
*.gba
*.nds
slink_path.cfg
node_modules/
.claude/
CLAUDE.md
tests/_tmp/
data/twitch_bot.json
data/obs_config.json
.tio.tokens.json
.env
.env.*
/dist/
# Phase 10: pret build tool caches (RGBDS binaries, cloned pret repos,
# intermediate .o files). data/pret_syms.json IS committed (50KB artifact
# so contributors without RGBDS can still run pytest).
/.cache/
/.lane/

# F-7: cache of the pinned Radical Red generator sources (tools/fetch_rr_sources.py);
# hash-verified and repopulated on demand, not checked in.
data/.rr_src_cache/

# Lua console tee (per-run debug log written by lua/slink.lua, truncated
# each boot — not useful in version control)
slink_lua.log

# Gen 3 battery-save fixtures are committed on purpose (docs/gen3/PLAN.md §5.5); the blanket *.sav rule above must not hide them
!tests/fixtures/gen3/*.sav

# C5-11b: the Gen 3 client's per-install session counter (lua/gen3/run.lua writes it at
# the install root, which is the repo root during dev runs).
slink_gen3_session.*

# Gen 3 durable trade journal (lua/gen3/run.lua), written beside the install root at runtime
/slink_gen3_trade.log
/slink_gen3_trade.guard
