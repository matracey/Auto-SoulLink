#!/usr/bin/env node
'use strict';

// TODO: use bundled output in official UI, switch Typescript version to generate modern JS

const Bundler = require('../bundler');
const bundler = new Bundler(__dirname);

// calc/data
let bundled = `(() => {
'use strict';
const exports = {};
`;
for (const file of [
  'util.js', 'data/species.js', 'data/types.js', 'data/natures.js',
  'data/abilities.js', 'data/moves.js', 'data/items.js', 'data/purergb.js', 'data/index.js',
]) {
  bundled += bundler.readModule(file);
}
bundled += `
// EXPORTS
window.calc = Object.assign(window.calc || {}, {
  Generations: exports.Generations,
  ABILITIES: exports.ABILITIES,
  ITEMS: exports.ITEMS,
  MEGA_STONES: exports.MEGA_STONES,
  MOVES: exports.MOVES,
  SPECIES: exports.SPECIES,
  NATURES: exports.NATURES,
  TYPE_CHART: exports.TYPE_CHART,
  useDex: exports.useDex,
});
})();`
bundler.bundle(bundled, 'data/production.min.js');

// calc
bundled = `(() => {
  'use strict';
  const exports = {};
  `;
for (const file of [
  'util.js', 'stats.js', 'pokemon.js', 'field.js', 'move.js', 'items.js',
  'mechanics/util.js', 'result.js', 'desc.js', 'mechanics/gen789.js',
  'mechanics/gen56.js', 'mechanics/gen4.js', 'mechanics/gen3.js', 'mechanics/gen12.js', 'calc.js',
]) {
  bundled += bundler.readModule(file);
}

bundled += `
// EXPORTS
window.calc = Object.assign(window.calc || {}, {
  Field: exports.Field,
  Side: exports.Side,
  Pokemon: exports.Pokemon,
  Move: exports.Move,
  calculate: exports.calculate,
  Result: exports.Result,
  toID: exports.toID,
  STATS: exports.STATS,
  Stats: exports.Stats,
});
})();`
bundler.bundle(bundled);
